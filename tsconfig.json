{
  "compilerOptions": {
    "target":              "ESNext",
    "useDefineForClassFields": true,
    "module":              "ESNext",
    "lib":                 ["ESNext", "DOM"],
    "moduleResolution":    "bundler",
    "resolveJsonModule":   true,
    "jsx":                 "preserve",
    "jsxImportSource":     "solid-js",
    "strict":              true,
    "noUnusedLocals":      true,
    "noUnusedParameters":  true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck":        true,
    "baseUrl":             ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "e2e"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
