# Kaname 環境変数テンプレート
# このファイルを .env にコピーして実値を設定する。
# .env は .gitignore で除外される (絶対にコミットしない)。

# ===== AI (BYOK: Bring Your Own Key) =====
# Anthropic API キー (ユーザー自身のキーを使用)
KANAME_ANTHROPIC_API_KEY=

# ローカル LLM エンドポイント (オプション、デフォルトはローカル推論)
KANAME_LOCAL_LLM_ENDPOINT=http://127.0.0.1:11434

# ===== メールサーバー (JMAP) =====
KANAME_JMAP_ENDPOINT=
KANAME_JMAP_USERNAME=

# ===== 課金 (Stripe、エンタープライズ向け) =====
# Webhook 署名検証用シークレット
KANAME_STRIPE_WEBHOOK_SECRET=

# ===== 暗号 =====
# SQLCipher データベース暗号化キーの導出元 (空ならOS keychainを使用)
KANAME_DB_KEY_SOURCE=keychain

# ===== 可観測性 =====
# OpenTelemetry エクスポート先 (オプション)
KANAME_OTEL_ENDPOINT=
# ログレベル (debug/info/warn/error)
KANAME_LOG_LEVEL=info

# ===== 環境 =====
# dev / staging / production
KANAME_ENV=dev
