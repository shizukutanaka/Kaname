src-tauri/target/
src-tauri/gen/

# IDE
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# 環境変数 (絶対にコミットしない)
.env
.env.local
.env.*.local
*.pem
*.p12

# テスト出力
target/nextest/
target/criterion/
bench_output.txt
test-results/
